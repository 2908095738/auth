<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clinic.mapper.DossierMapper">

    <resultMap id="BaseResultMap" type="com.clinic.entity.Dossier">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="patientId" column="patient_id" jdbcType="BIGINT"/>
            <result property="isFirst" column="is_first" jdbcType="TINYINT"/>
            <result property="chiefComplaint" column="chief_complaint" jdbcType="VARCHAR"/>
            <result property="primaryDiagnosis" column="primary_diagnosis" jdbcType="VARCHAR"/>
            <result property="temperature" column="temperature" jdbcType="DOUBLE"/>
            <result property="physicalExamination" column="physical_examination" jdbcType="VARCHAR"/>
            <result property="medicalTreatment" column="medical_treatment" jdbcType="VARCHAR"/>
            <result property="notes" column="notes" jdbcType="VARCHAR"/>
            <result property="doctor" column="doctor" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,patient_id,is_first,
        chief_complaint,primary_diagnosis,temperature,
        
physical_examination,medical_treatment,notes,
        
doctor,create_time,update_time
    </sql>
</mapper>
