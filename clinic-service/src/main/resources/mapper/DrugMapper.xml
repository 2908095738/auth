<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clinic.mapper.DrugMapper">

    <resultMap id="BaseResultMap" type="com.clinic.entity.Drug">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="name" column="name" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="type" column="type" jdbcType="TINYINT"/>
            <result property="size" column="size" jdbcType="VARCHAR"/>
            <result property="unit" column="unit" jdbcType="CHAR"/>
            <result property="origin" column="origin" jdbcType="VARCHAR"/>
            <result property="manufacturer" column="manufacturer" jdbcType="VARCHAR"/>
            <result property="drugNo" column="drug_no" jdbcType="VARCHAR"/>
            <result property="cost" column="cost" jdbcType="DECIMAL"/>
            <result property="remark" column="remark" jdbcType="VARCHAR"/>
            <result property="approvalNumber" column="approval_number" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,name,create_time,
        update_time,type,size,
        unit,origin,manufacturer,
        drug_no,cost,remark,
        approval_number
    </sql>
</mapper>
